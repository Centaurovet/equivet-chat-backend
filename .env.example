# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o GitHub

ANTHROPIC_API_KEY=sk-ant-...

# Domínios autorizados (separados por vírgula, sem espaço)
# Use * para permitir qualquer origem (só durante testes)
# Exemplo produção: https://equivet.com.br,https://www.equivet.com.br
ALLOWED_ORIGINS=*

# Rate limiting (opcional — padrões já configurados)
RATE_LIMIT=15
RATE_WINDOW_SEC=60
